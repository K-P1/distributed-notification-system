# =============================================================================
# Distributed Notification System – .gitignore
# Covers: API Gateway (FastAPI), User Service, Template Service, Email Service,
# Push Service, shared infra, Docker, Python, Node/Bun, TypeScript/NestJS,
# CI/CD, logs, secrets, etc.
# =============================================================================

# --------------------------------------------------------------------------- #
# 1. Python / FastAPI (API Gateway)
# --------------------------------------------------------------------------- #
# Byte-compiled / optimized / DLLs
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# uv / pipenv / poetry
uv.lock
Pipfile
Pipfile.lock
poetry.lock
.pip-cache/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# pytest
.pytest_cache/
htmlcov/
.coverage
.coverage.*

# ruff
.ruff_cache/

# Alembic migrations env
alembic/env.py

# --------------------------------------------------------------------------- #
# 2. Node / Bun / TypeScript / NestJS (other services)
# --------------------------------------------------------------------------- #
node_modules/
dist/
build/
*.tsbuildinfo
bun.lockb

# NestJS
.nest/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# --------------------------------------------------------------------------- #
# 3. Docker
# --------------------------------------------------------------------------- #
.docker/
docker-compose.override.yml
*.dockerignore

# Docker volumes (named volumes are fine, but bind mounts can be ignored)
docker-data/

# --------------------------------------------------------------------------- #
# 4. Secrets / Config
# --------------------------------------------------------------------------- #
.env
.env.local
.env.*.local
.env.sample
.env.example
*.pem
*.key
*.crt
*.jks
*.p12

# --------------------------------------------------------------------------- #
# 5. Build / CI / CD
# --------------------------------------------------------------------------- #
target/
out/
bin/
obj/
*.log
*.tmp
*.bak
*.swp
*.swn
*.swo

# CI caches
.cache/
.ci-cache/

# GitHub Actions / GitLab CI
.github/workflows/*.yml
.gitlab-ci.yml

# --------------------------------------------------------------------------- #
# 6. Database / Cache
# --------------------------------------------------------------------------- #
*.db
*.sqlite3
*.dump
pgdata/
redis-data/
rabbitmq-data/

# --------------------------------------------------------------------------- #
# 7. Documentation / Misc
# --------------------------------------------------------------------------- #
docs/_build/
docs/build/
*.pdf
*.drawio.bak

# --------------------------------------------------------------------------- #
# 8. Local development tools
# --------------------------------------------------------------------------- #
.local/
tmp/
temp/

# --------------------------------------------------------------------------- #
# 9. Service-specific ignores (add as needed)
# --------------------------------------------------------------------------- #
# Email Service (if using SendGrid/Mailgun keys)
mail_credentials.json

# Push Service (FCM service account)
firebase-adminsdk.json

# --------------------------------------------------------------------------- #
# 10. Root-level files that should never be committed
# --------------------------------------------------------------------------- #
/infra/.env
/infra/docker-compose.override.yml
/infra/*.secret.yml

# --------------------------------------------------------------------------- #
# End of .gitignore
# --------------------------------------------------------------------------- #