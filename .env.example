# Distributed Notification System - Environment Variables
# This file contains all environment variables used across the system
# Copy this to .env and fill in your actual values

# =============================================================================
# GENERAL / SHARED CONFIGURATION
# =============================================================================

# Environment (development, production, staging)
NODE_ENV=development

# Application Version
VERSION=1.0.0

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# API Gateway Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=gateway_user
POSTGRES_PASSWORD=gatewaypassword
POSTGRES_DB=gateway_db
DATABASE_URL=postgresql://gateway_user:gatewaypassword@localhost:5432/gateway_db

# User Service Database
USER_POSTGRES_HOST=localhost
USER_POSTGRES_PORT=5432
USER_POSTGRES_USER=user_svc
USER_POSTGRES_PASSWORD=userpassword
USER_POSTGRES_DB=user_db
USER_DATABASE_URL=postgresql://user_svc:userpassword@localhost:5432/user_db

# Template Service Database
TEMPLATE_DB_HOST=127.0.0.1
TEMPLATE_DB_PORT=5432
TEMPLATE_DB_USER=template_user
TEMPLATE_DB_PASSWORD=password123
TEMPLATE_DB_NAME=template_db
TEMPLATE_DATABASE_URL=postgresql://template_user:password123@127.0.0.1:5432/template_db

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

REDIS_HOST=redis://:redispassword@localhost:6379/0
REDIS_PORT=6379
REDIS_PASSWORD=redispassword
REDIS_URL=redis://:redispassword@localhost:6379/0

# Template Service Redis (separate DB)
TEMPLATE_REDIS_URL=redis://:redispassword@127.0.0.1:6379/1

# =============================================================================
# RABBITMQ CONFIGURATION
# =============================================================================

RABBITMQ_HOST=amqp://admin:secretpassword@localhost:5672/
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=secretpassword
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://admin:secretpassword@localhost:5672/

# Queue Names
EMAIL_QUEUE_NAME=email.queue
PUSH_QUEUE_NAME=push.queue
EXCHANGE_NAME=notifications.direct
DLX_NAME=notifications.dlx
FAILED_QUEUE_NAME=failed.queue

# =============================================================================
# SERVICE URLS AND PORTS
# =============================================================================

# API Gateway
API_GATEWAY_URL=http://localhost:8000
API_GATEWAY_PORT=8000

# User Service
USER_SERVICE_URL=http://localhost:3000
USER_SERVICE_PORT=3000

# Template Service
TEMPLATE_SERVICE_URL=http://localhost:3002
TEMPLATE_SERVICE_PORT=3002

# Email Service
EMAIL_SERVICE_PORT=3001

# Push Service
PUSH_SERVICE_PORT=8003

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# JWT Secrets (Generate secure random strings for production)
JWT_SECRET=your-secret-key-change-in-production-please-use-strong-random-key
REFRESH_TOKEN_SECRET=your-refresh-secret-key-change-in-production
JWT_SECRET_KEY=your-secret-key-change-in-production-please-use-strong-random-key

# API Keys (comma-separated)
VALID_API_KEYS=test-api-key,api-key-1

# =============================================================================
# EMAIL / SMTP CONFIGURATION
# =============================================================================

SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=test
SMTP_PASSWORD=test
FROM_EMAIL=noreply@example.com
FROM_NAME=Notification Service

# =============================================================================
# PUSH NOTIFICATIONS
# =============================================================================

FIREBASE_CREDENTIALS=/path/to/firebase-service-account.json

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

LOG_LEVEL=info
ENABLE_JSON_LOGGING=true

# Metrics
METRICS_PORT=9090
ENABLE_METRICS=true

# Health Checks
HEALTH_CHECK_INTERVAL=30000

# =============================================================================
# CIRCUIT BREAKER & RETRY CONFIGURATION
# =============================================================================

CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60000
MAX_RETRIES=3
RETRY_DELAY_MS=1000
EXPONENTIAL_BACKOFF=true

# =============================================================================
# TIMEOUTS
# =============================================================================

API_GATEWAY_TIMEOUT=10000
TEMPLATE_SERVICE_TIMEOUT=5000

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================

TEMPLATE_CACHE_TTL=3600
TEMPLATE_CACHE_MAX_SIZE=1000

# =============================================================================
# TEMPLATE VALIDATION
# =============================================================================

MAX_TEMPLATE_SIZE=1048576
ALLOWED_TEMPLATE_TYPES=email,push
SUPPORTED_LANGUAGES=en,es,fr,de

# =============================================================================
# RATE LIMITING
# =============================================================================

RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# DOCKER ENVIRONMENT FLAG
# =============================================================================

# Set to 'docker' when running in Docker containers
ENV=local