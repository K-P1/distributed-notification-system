# Email Service Production Environment Configuration

# Service Configuration
NODE_ENV=production
PORT=3001
LOG_LEVEL=info
ENABLE_JSON_LOGGING=true

# RabbitMQ Configuration - CloudAMQP Production
RABBITMQ_URL=amqps://neoxhbgv:ObO_9mg7l72Qavudd_4cAgv5o4nkmklS@gorilla.lmq.cloudamqp.com/neoxhbgv
RABBITMQ_HOST=gorilla.lmq.cloudamqp.com
RABBITMQ_USERNAME=neoxhbgv
RABBITMQ_PASSWORD=ObO_9mg7l72Qavudd_4cAgv5o4nkmklS
RABBITMQ_VHOST=neoxhbgv
RABBITMQ_PORT=5671

EMAIL_QUEUE_NAME=email.queue.omoke
EXCHANGE_NAME=notifications.direct
DLX_NAME=notifications.dlx.omoke
FAILED_QUEUE_NAME=failed.queue.omoke

# SMTP Configuration - Update with real SMTP service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-production-email@gmail.com
SMTP_PASSWORD=your-production-app-password
FROM_EMAIL=noreply@yourcompany.com
FROM_NAME=Notification Service

# Redis Configuration - Update with production Redis URL
REDIS_URL=redis://localhost:6379

# Circuit Breaker Configuration
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60000

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY_MS=1000
EXPONENTIAL_BACKOFF=true

# Service URLs - Update with production URLs
API_GATEWAY_URL=http://localhost:8000
API_GATEWAY_TIMEOUT=10000
TEMPLATE_SERVICE_URL=https://your-template-service.railway.app
TEMPLATE_SERVICE_TIMEOUT=5000

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000

# Metrics Configuration
METRICS_PORT=9090
ENABLE_METRICS=true