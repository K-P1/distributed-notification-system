# Email Service Environment Variables

# Service Configuration
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
ENABLE_JSON_LOGGING=true

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672
EMAIL_QUEUE_NAME=email.queue
EXCHANGE_NAME=notifications.direct
DLX_NAME=notifications.dlx
FAILED_QUEUE_NAME=failed.queue

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@yourcompany.com
FROM_NAME=Your Company

# Redis Configuration (for caching/rate limiting)
REDIS_URL=redis://localhost:6379

# Circuit Breaker Configuration
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60000

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY_MS=1000
EXPONENTIAL_BACKOFF=true

# API Gateway Configuration
API_GATEWAY_URL=http://localhost:8000
API_GATEWAY_TIMEOUT=10000

# Template Service Configuration
TEMPLATE_SERVICE_URL=http://localhost:3002
TEMPLATE_SERVICE_TIMEOUT=5000

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000

# Metrics Configuration
METRICS_PORT=9090
ENABLE_METRICS=true
