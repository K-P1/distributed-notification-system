NODE_ENV=development
PORT=3001

# RabbitMQ Configuration
RABBITMQ_URL=amqp://admin:secretpassword@localhost:5672/
EMAIL_QUEUE_NAME=email.queue
EXCHANGE_NAME=notifications.direct
DLX_NAME=notifications.dlx
FAILED_QUEUE_NAME=failed.queue

# Redis Configuration
REDIS_URL=redis://:redispassword@localhost:6379/0

# SMTP Configuration (Test configuration)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=test
SMTP_PASSWORD=test
SMTP_SECURE=false
FROM_EMAIL=noreply@example.com
FROM_NAME=Notification Service

# External Services
API_GATEWAY_URL=http://localhost:8000
TEMPLATE_SERVICE_URL=http://localhost:3002
API_GATEWAY_TIMEOUT=10000
TEMPLATE_SERVICE_TIMEOUT=5000

# Circuit Breaker Configuration
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60000

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY_MS=1000
EXPONENTIAL_BACKOFF=true

# Logging Configuration
LOG_LEVEL=debug
ENABLE_JSON_LOGGING=true

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000

# Metrics Configuration
METRICS_PORT=9090
ENABLE_METRICS=true