# Local Development with CloudAMQP
NODE_ENV=development
PORT=3001

# CloudAMQP Configuration - Production RabbitMQ
RABBITMQ_URL=amqps://neoxhbgv:ObO_9mg7l72Qavudd_4cAgv5o4nkmklS@gorilla.lmq.cloudamqp.com/neoxhbgv

# Queue Configuration (with unique names to avoid team conflicts)
EMAIL_QUEUE_NAME=email.queue.omoke
EXCHANGE_NAME=notifications.direct
DLX_NAME=notifications.dlx.omoke
FAILED_QUEUE_NAME=failed.queue.omoke

# SMTP Configuration (using mock for testing)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=test@example.com
SMTP_PASSWORD=testpassword
SMTP_SECURE=false
FROM_EMAIL=noreply@yourcompany.com
FROM_NAME=Notification Service

# Redis Configuration (local)
REDIS_URL=redis://localhost:6379

# Circuit Breaker Configuration
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60000

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY_MS=1000
EXPONENTIAL_BACKOFF=true

# Logging
LOG_LEVEL=info
ENABLE_JSON_LOGGING=true

# Service URLs (local development)
API_GATEWAY_URL=http://localhost:8000
TEMPLATE_SERVICE_URL=http://localhost:3002