# ============================================
# API Gateway Configuration
# ============================================
APP_NAME=api-gateway
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ============================================
# RabbitMQ Configuration
# ============================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=secretpassword
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://admin:secretpassword@rabbitmq:5672/

# RabbitMQ Management API
RABBITMQ_MGMT_HOST=rabbitmq
RABBITMQ_MGMT_PORT=15672
RABBITMQ_MGMT_URL=http://rabbitmq:15672

# Exchange & Queues
RABBITMQ_EXCHANGE=notifications.direct
RABBITMQ_DLX=notifications.dlx
RABBITMQ_EMAIL_QUEUE=email.queue
RABBITMQ_PUSH_QUEUE=push.queue
RABBITMQ_FAILED_QUEUE=failed.queue

# Queue Settings
QUEUE_MESSAGE_TTL=86400000
QUEUE_MAX_LENGTH=100000
RABBITMQ_CONNECTION_TIMEOUT=10
RABBITMQ_HEARTBEAT=60
RABBITMQ_PREFETCH_COUNT=10

# ============================================
# User Service Configuration
# ============================================
USER_SERVICE_URL=http://user-service:8001
USER_SERVICE_TIMEOUT=2.0
USER_SERVICE_MAX_RETRIES=3
USER_SERVICE_RETRY_DELAY=0.5
USER_SERVICE_CIRCUIT_FAILURE_THRESHOLD=5
USER_SERVICE_CIRCUIT_RECOVERY_TIMEOUT=30

# ============================================
# Template Service Configuration
# ============================================
TEMPLATE_SERVICE_URL=http://template-service:8002
TEMPLATE_SERVICE_TIMEOUT=2.0
TEMPLATE_SERVICE_MAX_RETRIES=3
TEMPLATE_SERVICE_RETRY_DELAY=0.5
TEMPLATE_SERVICE_CIRCUIT_FAILURE_THRESHOLD=5
TEMPLATE_SERVICE_CIRCUIT_RECOVERY_TIMEOUT=30

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=redispassword
REDIS_URL=redis://:redispassword@redis:6379/0

# Connection Pool
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# TTL Settings
IDEMPOTENCY_TTL=86400
STATUS_CACHE_TTL=3600
SERVICE_CACHE_TTL=300
RATE_LIMIT_WINDOW=60

# ============================================
# PostgreSQL Configuration
# ============================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=gateway_user
POSTGRES_PASSWORD=gatewaypassword
POSTGRES_DB=gateway_db
DATABASE_URL=postgresql+asyncpg://gateway_user:gatewaypassword@postgres:5432/gateway_db

# Connection Pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ============================================
# Authentication Configuration
# ============================================
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# API Keys
API_KEY_PREFIX=apk_
API_KEY_LENGTH=32

# ============================================
# Rate Limiting Configuration
# ============================================
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_ADMIN=1000
RATE_LIMIT_CLIENT=100
RATE_LIMIT_SERVICE=500

# ============================================
# Monitoring Configuration
# ============================================
METRICS_PORT=9090
METRICS_PATH=/metrics
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_INTERVAL=30

# ============================================
# Correlation ID Configuration
# ============================================
CORRELATION_ID_HEADER=X-Correlation-ID
CORRELATION_ID_LENGTH=32
