# Template Service Production Environment Configuration

# Server Configuration
NODE_ENV=production
PORT=3002
VERSION=1.0.0

# Database Configuration - Railway PostgreSQL
DB_HOST=switchyard.proxy.rlwy.net
DB_PORT=27606
DB_USER=postgres
DB_PASSWORD=UHTEsZprjEaPgeStWNWXIiLlJTLoNgEd
DB_NAME=railway
DATABASE_URL=postgresql://postgres:UHTEsZprjEaPgeStWNWXIiLlJTLoNgEd@switchyard.proxy.rlwy.net:27606/railway

# Redis Configuration - Railway Redis
# These will be automatically populated by Railway when you add Redis
REDIS_HOST=${REDISHOST}
REDIS_PORT=${REDISPORT}
REDIS_PASSWORD=${REDISPASSWORD}
REDIS_URL=${REDIS_URL}
REDIS_DB=0

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Circuit Breaker Configuration
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30000
CIRCUIT_BREAKER_MONITORING_PERIOD=10000

# Validation Configuration
MAX_TEMPLATE_SIZE=1048576
MAX_VARIABLES_COUNT=50
MAX_TAGS_COUNT=20

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5000

# CORS Configuration for production
CORS_ORIGIN=https://your-api-gateway.railway.app,https://your-frontend.railway.app
CORS_CREDENTIALS=true