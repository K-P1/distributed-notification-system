# Template Service Environment Configuration

# Server Configuration
PORT=3002
NODE_ENV=development
VERSION=1.0.0

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=template_user
DB_PASSWORD=template_password
DB_NAME=template_db
DATABASE_URL=postgresql://template_user:template_password@localhost:5432/template_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=2

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Circuit Breaker Configuration
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30000
CIRCUIT_BREAKER_MONITORING_PERIOD=10000

# Validation Configuration
MAX_TEMPLATE_SIZE=1048576
MAX_VARIABLES_COUNT=50
MAX_TAGS_COUNT=20

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5000
