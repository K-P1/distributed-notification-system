NODE_ENV=development
PORT=3002
VERSION=1.0.0

# Database Configuration
DATABASE_URL=postgresql://template_user:password123@127.0.0.1:5432/template_db
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=template_user
DB_PASSWORD=password123
DB_NAME=template_db

# Redis Configuration
REDIS_URL=redis://:redispassword@127.0.0.1:6379/1
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Cache Configuration
TEMPLATE_CACHE_TTL=3600
TEMPLATE_CACHE_MAX_SIZE=1000

# Circuit Breaker Configuration
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60000

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY_MS=1000

# Logging Configuration
LOG_LEVEL=debug
ENABLE_JSON_LOGGING=true

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000

# Metrics Configuration
METRICS_PORT=9091
ENABLE_METRICS=true

# Template Validation Configuration
MAX_TEMPLATE_SIZE=1048576
ALLOWED_TEMPLATE_TYPES=email,push
SUPPORTED_LANGUAGES=en,es,fr,de

# Rate Limiting Configuration
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=100